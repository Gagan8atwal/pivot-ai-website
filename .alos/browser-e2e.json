{
  "schema": "alos.browser-e2e-spec.v1",
  "projectKey": "pivot-ai-website",
  "runner": "Gagan8atwal/al-solutions-command-center:alos/runtime/project-browser-acceptance.ts",
  "sideEffects": "forbidden",
  "acceptance": {
    "requireTwoDisjointSessions": true,
    "requireCorrelatedEvidenceEveryAction": true,
    "requireExactPinnedSource": true,
    "requireSameOwnerConsumption": true,
    "maxPaidCostUsd": 0,
    "reliabilityProof": {
      "kind": "retry",
      "expectText": "SETUP:RELOAD-RESUMES-SAVED-STATE"
    }
  },
  "journeys": [
    {
      "label": "mobile-signup-to-fast-onboarding",
      "width": 390,
      "height": 844,
      "startPagePath": "/",
      "expectText": "Start 5-Minute Setup",
      "steps": [
        {
          "type": "page",
          "pagePath": "/signup",
          "expectText": "Create your Pivot account"
        },
        {
          "type": "fill",
          "match": "Full name",
          "text": "ALOS QA User"
        },
        {
          "type": "fill",
          "match": "Business name",
          "text": "ALOS QA Dental"
        },
        {
          "type": "fill",
          "match": "Work email",
          "text": "qa@example.test"
        },
        {
          "type": "fill",
          "match": "Password",
          "text": "TestingOnly123!"
        },
        {
          "type": "page",
          "pagePath": "/onboarding",
          "expectText": "5-minute setup"
        },
        {
          "type": "fill",
          "match": "Business name",
          "text": "ALOS QA Dental"
        },
        {
          "type": "fill",
          "match": "Timezone",
          "text": "America/Los_Angeles"
        },
        {
          "type": "fill",
          "match": "Business hours",
          "text": "Mon-Fri 8 AM-5 PM"
        },
        {
          "type": "fill",
          "match": "Services",
          "text": "Cleanings, emergency visits"
        },
        {
          "type": "fill",
          "match": "Existing receptionist number",
          "text": "+15595550199"
        },
        {
          "type": "snapshot",
          "expectText": "Save setup & activate if ready"
        }
      ]
    },
    {
      "label": "desktop-fast-onboarding-test-call",
      "width": 1440,
      "height": 900,
      "startPagePath": "/onboarding",
      "expectText": "Four required business facts",
      "steps": [
        {
          "type": "click",
          "match": "Start fresh recovery proof",
          "expectText": "SETUP:RECOVERY-RESET"
        },
        {
          "type": "fill",
          "match": "Business name",
          "text": "ALOS QA Dental"
        },
        {
          "type": "fill",
          "match": "Timezone",
          "text": "America/Los_Angeles"
        },
        {
          "type": "fill",
          "match": "Business hours",
          "text": "Mon-Fri 8 AM-5 PM"
        },
        {
          "type": "fill",
          "match": "Services",
          "text": "Cleanings, emergency visits"
        },
        {
          "type": "fill",
          "match": "Existing receptionist number",
          "text": "+15595550199"
        },
        {
          "type": "click",
          "match": "Save setup & activate if ready",
          "expectText": "SETUP:RELOAD-RESUMES-SAVED-STATE"
        },
        {
          "type": "click",
          "match": "Save setup & activate if ready",
          "expectText": "SETUP:RECOVERY-IDEMPOTENT"
        },
        {
          "type": "reopen",
          "pagePath": "/onboarding",
          "expectText": "SETUP:RELOAD-RESUMES-SAVED-STATE"
        },
        {
          "type": "snapshot",
          "expectText": "Call my receptionist"
        },
        {
          "type": "snapshot",
          "expectText": "Open dashboard"
        },
        {
          "type": "snapshot",
          "expectText": "SETUP:RELOAD-RESUMES-SAVED-STATE"
        },
        {
          "type": "click",
          "match": "Clear recovered setup proof",
          "expectText": "SETUP:RECOVERY-CLEARED"
        },
        {
          "type": "reopen",
          "pagePath": "/onboarding",
          "expectText": "SETUP:RECOVERY-NOT-SAVED"
        },
        {
          "type": "click",
          "match": "Test stale setup isolation",
          "expectText": "SETUP:RECOVERY-CONTEXT-MISMATCH"
        },
        {
          "type": "click",
          "match": "Clear recovered setup proof",
          "expectText": "SETUP:RECOVERY-CLEARED"
        },
        {
          "type": "reopen",
          "pagePath": "/onboarding",
          "expectText": "SETUP:RECOVERY-NOT-SAVED"
        },
        {
          "type": "click",
          "match": "Test setup replay rejection",
          "expectText": "SETUP:RECOVERY-REPLAY-REJECTED"
        },
        {
          "type": "click",
          "match": "Clear recovered setup proof",
          "expectText": "SETUP:RECOVERY-CLEARED"
        },
        {
          "type": "reopen",
          "pagePath": "/onboarding",
          "expectText": "SETUP:RECOVERY-NOT-SAVED"
        }
      ]
    }
  ]
