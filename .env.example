# Resend API Key for sending emails
RESEND_API_KEY=re_123456789

# Email where form submissions will be sent
OWNER_EMAIL=hello@pivotcalls.co

# Email that will appear as the sender (must be a Resend-verified domain address)
FROM_EMAIL=Pivot AI <hello@pivotcalls.co>

# Supabase service role (server-only) — used by the marketing API routes
# (app/api/demo, app/api/contact) to persist submissions. NEVER expose to the browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dashboard owner UUID — the auth.users id of the Pivot AI dashboard owner.
# Contact and demo form leads will be assigned to this user so they appear
# in the dashboard CRM at /protected/leads.
# Defaults to the known single-tenant owner id if unset (no Vercel env step required).
DASHBOARD_OWNER_ID=3fbf8a9e-0185-4445-868b-2b93258080cb

# ─────────────────────────────────────────────────────────────────────────────
# Unified app frontend (consumes the owned/self-hosted Fastify backend)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the owned/self-hosted ai-receptionist-voice backend API.
# Required. There is intentionally no hosted-provider fallback.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3001

# Supabase project URL (public — safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon/public key (public — safe to expose in the browser).
# This is NOT the service-role key. The service-role key stays server-only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
